---
import ResourceRow from './ResourceRow.astro';
import { slug } from '../lib/notion';
import type { Resource } from '../lib/notion';
const { name, items } = Astro.props as { name: string; items: Resource[] };
---
<section id={slug(name)} data-section class="scroll-mt-10">
  <h2 class="mb-1.5 text-sm text-neutral-500">
    {name} <span class="text-neutral-300">{items.length}</span>
  </h2>
  <div class="flex flex-col">
    {items.map((r) => <ResourceRow r={r} />)}
  </div>
</section>
